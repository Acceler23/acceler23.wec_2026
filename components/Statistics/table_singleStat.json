[
    // fastest lap
    {
        "ComponentName": "TableStandingSingle_FastestLap",
        "BlockType": "table",
        "TableOptions": {
            "ItemsSource": "{Standings.Drivers}",
            "OrderByDescending": "RaceDetails.FastestLapWinsCount",
            "OrderBy2": "RaceDetails.AverageFastestLapGapToLeader",
            "HeaderTemplate": {
                "BlockType": "text",
                "Style": "TableStats_Header"
            },
            "Columns": [
                {
                    "Header": "[Pos.]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Position_SingleStats",
                        "ComponentOptions": {
                            "Vars": {
                                "position": "{Item.Index, Converter=NumberAdd, Parameter=1}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Competitors]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "LiveryLine_Stats"
                    }
                },
                {
                    "Header": "[N°]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Number_Stats"
                    }
                },
                {
                    "Header": "[Driver]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Driver_Stats",
                        "RenderIf": "{ShowDriver_Stats}"
                    }
                },
                {
                    "Header": "[Team]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Team_Stats",
                        "RenderIf": "{ShowTeam_Stats}"
                    }
                },
                {
                    "Header": "[Position\nin track]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.RaceDetails.AverageFastestLapPosition, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Fastests\nlap count]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.RaceDetails.FastestLapWinsCount, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Average\ngap]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.RaceDetails.AverageFastestLapGapToLeader}"
                            }
                        }
                    }
                }
            ]
        }
    },
