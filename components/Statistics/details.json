                "FontSize": 24,
                "HorizontalAlignment": "Left",
                "VerticalAlignment": "Center"
            },
            {
                "BlockType": "text",
                "Source": "[{Standings.RacingClass.Name, Converter=StringToUpperString}]",
                "Style": "Stats_Header",
                "FontSize": 24,
                "HorizontalAlignment": "Left",
                "VerticalAlignment": "Center"
            },
            {
                "BlockType": "text",
                "Source": "[{Season.Name, Converter=StringToUpperString}]",
                "Style": "Stats_Header",
                "FontSize": 24,
                "HorizontalAlignment": "Left",
                "VerticalAlignment": "Center"
            },
            {
                "BlockType": "text",
                "Source": "<standType>",
                "Style": "Stats_Header",
                "FontSize": 24,
                "HorizontalAlignment": "Left",
                "VerticalAlignment": "Center"
            }
        ]
    },
    //statistics head
    {
        "ComponentName": "StatisticssHead_stats",
        "BlockType": "stack",
        "Orientation": "Vertical",
        "HorizontalAlignment": "Left",
        "Spacing": -10,
        "Items": [
            {
                "BlockType": "stack",
                "Orientation": "Horizontal",
                "Spacing": -5,
                "Items": [
                    {
                        "BlockType": "text",
                        "Source": "[{Season.LeagueInfo.LeagueName, Converter=StringToUpperString}]",
                        "Style": "Stats_Header",
                        "FontSize": 24,
                        "HorizontalAlignment": "Left",
                        "VerticalAlignment": "Center"
                    },
                    {
                        "BlockType": "text",
                        "Source": "[{Statistics.RacingClass.Name, Converter=StringToUpperString}]",
                        "Style": "Stats_Header",
                        "FontSize": 24,
                        "HorizontalAlignment": "Left",
                        "VerticalAlignment": "Center"
                    },
                    {
                        "BlockType": "text",
                        "Source": "[{Season.Name, Converter=StringToUpperString}]",
                        "Style": "Stats_Header",
                        "FontSize": 24,
                        "HorizontalAlignment": "Left",
                        "VerticalAlignment": "Center"
                    }
                ]
            },
            {
                "BlockType": "text",
                "Source": "[DRIVERS' {Statistics.StatisticsTypeString}]",
                "Style": "Stats_Header",
                "FontSize": 24,
                "HorizontalAlignment": "Left",
                "VerticalAlignment": "Center"
            }
        ]
    }
]