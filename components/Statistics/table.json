                                            "Color": "{{Item.TyresInfo.Name}_color}"
                                        }
                                    },
                                    {
                                        "BlockType": "shape",
                                        "VerticalAlignment": "Center",
                                        "PositionY": 5,
                                        "PositionX": 10,
                                        "PositionZ": 1,
                                        "Height": 26,
                                        "Width": "{{Item.Laps, Converter=NumberSubtract, Parameter=1}, Converter=NumberMultiply, Parameter=31}",
                                        "ShapeOptions": {
                                            "Fill": "{{Item.TyresInfo.Name}_color}"
                                        }
                                    }
                                ]
                            }
                        }
                    }
                },
                {
                    "Header": "",
                    "Template": {
                        "BlockType": "component",
                        "Component": "LeaderCut_stintStat"
                    }
                }
            ]
        }
    },
