                                        "BlockType": "text",
                                        "Source": "{Item.Laps}",
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Center",
                                        "Style": "TableStats_Line",
                                        "PositionZ": 2,
                                        "Height": 26,
                                        "Width": 26,
                                        "Foreground": "{{Item.TyresInfo.Name}_color}",
                                        "BackgroundImage": "logotypes/tyres/tyre_ring.png",
