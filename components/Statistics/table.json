    //standings
    //points progression
    {
        "ComponentName": "PointsProgression_Stats",
        "BlockType": "table",
        "Triggers": [
            {
                "Condition": "<isTeam>",
                "Property": "TableOptions.ItemsSource",
                "Value": "{Standings.Teams}"
            }
        ],
        "TableOptions": {
            "ItemsSource": "{Standings.Drivers}",
            "HeaderTemplate": {
                "BlockType": "text",
                "Style": "TableStats_Header"
            },
            "Columns": [
                {
                    "Header": "[Pos.]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Position_Stats"
                    }
                },
                {
                    "Header": "[Manufacturer]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "LogoAlt_Stats",
                        "RenderIf": false,
                        "Triggers": [
                            {
                                "Condition": "<isTeam>",
                                "ConditionAnd": "{Standings.RacingClass.FirstFactor.CarClass.Name, Converter=StringNotEquals, Parameter=GT3}",
                                "Property": "RenderIf",
                                "Value": true
                            }
                        ]
                    }
                },
                {
                    "Header": "",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Teams_Stats",
                        "RenderIf": false,
                        "Triggers": [
                            {
                                "Condition": "<isTeam>",
                                "ConditionAnd": "{Standings.RacingClass.FirstFactor.CarClass.Name, Converter=StringNotEquals, Parameter=GT3}",
                                "Property": "RenderIf",
                                "Value": true
                            }
                        ]
                    }
                },
                {
                    "Header": "[Man.]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Logo_Stats",
                        "RenderIf": "<IsDriver>"
                    }
                },
                {
                    "Header": "[Competitors]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "LiveryLine_Stats",
                        "RenderIf": false,
                        "Triggers": [
                            {
                                "Condition": "<isTeam>",
                                "ConditionAnd": "{Standings.RacingClass.FirstFactor.CarClass.Name, Converter=StringEquals, Parameter=GT3}",
                                "Property": "RenderIf",
                                "Value": true
                            }
                        ]
                    }
                },
                {
                    "Header": "[N°]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Number_Stats",
                        "RenderIf": true,
                        "Triggers": [
                            {
                                "Condition": "<isTeam>",
                                "Property": "RenderIf",
                                "Value": false
                            }
                        ]
                    }
                },
                {
                    "Header": "[Drivers]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Driver_Stats",
                        "RenderIf": true,
                        "Triggers": [
                            {
                                "Condition": "<isTeam>",
                                "Property": "RenderIf",
                                "Value": false
                            }
                        ]
                    }
                },
                {
                    "MultiColumnHeadersSource": "{Standings.Events}",
                    "MultiColumnItemsSource": "{Item.Events}",
                    "MultiColumnHeaderTemplate": {
                        "BlockType": "dock",
                        "Width": 40,
                        "Height": 28,
                        "Margin": "5",
                        "Items": [
                            {
                                "BlockType": "image",
                                "Source": "{Item.Track.Nation.LogotypePath}",
                                "Width": 38,
                                "VerticalAlignment": "Center",
                                "HorizontalAlignment": "Center",
                                "Background": "{black}",
                                "Padding": "2",
                                "Triggers": [
                                    {
                                        "Condition": "{Item.CompletedStatus}",
                                        "ConditionValue": "InFuture",
                                        "Property": "Opacity",
                                        "Value": 50
                                    },
                                    {
                                        "Condition": "{Item.CompletedStatus}",
                                        "ConditionValue": "Skipped",
                                        "Setters": [
                                            {
                                                "Property": "Colorize.Color",
                                                "Value": "#aaff0000"
                                            },
                                            {
                                                "Property": "Colorize.ColorBlendingMode",
                                                "Value": "Darken"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    "Template": {
                        "BlockType": "component",
                        "Component": "PointsProg_Stats"
                    }
                },
                {
                    "Header": "[Total\npoints]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "PointsTotal_Stats"
                    }
                }
            ]
        }
    },
