[
    //race
    {
        "ComponentName": "TableSessionRace_SimpleStats",
        "BlockType": "table",
        "TableOptions": {
            "ItemsSource": "{Session.Drivers}",
            "HeaderTemplate": {
                "BlockType": "text",
                "Style": "TableStats_Header"
            },
            "Columns": [
                {
                    "Header": "[Pos.]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Position_Stats"
                    }
                },
                {
                    "Header": "[Started]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowStarted_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.GridPosition}"
                            }
                        }
                    }
                },
                {
                    "Header": "[+/-]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "PosJump_Stats",
                        "RenderIf": "{ShowPosJump_Stats}"
                    }
                },
                {
                    "Header": "[Competitors]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "LiveryLine_Stats"
                    }
                },
                {
                    "Header": "[N°]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Number_Stats"
                    }
                },
                {
                    "Header": "[Driver]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Driver_Stats",
                        "RenderIf": "{ShowDriver_Stats}"
                    }
                },
                {
                    "Header": "[Team]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Team_Stats",
                        "RenderIf": "{ShowTeam_Stats}"
                    }
                },
                {
                    "Header": "[Laps]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowLaps_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.LapsCount}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Lead\nlaps]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowLeadLaps_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.LeadLaps, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Lead\ndistance]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowLeadDistance_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.LeadDistance, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Race\ndistance (%)]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowRaceDistancePercentage_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.RaceDistancePercentage, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Total time]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowTotalTime_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.AbsoluteTime}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Penalty (s)]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowPenalty_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.PenaltyTimeTotal, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Penalty\n(pos)]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowPenalty_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.PenaltyPosTotal, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Gap]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Gap_Stats",
                        "RenderIf": "{ShowGap_Stats}"
                    }
                },
                {
                    "Header": "[Interval]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Interval_Stats",
                        "RenderIf": "{ShowInterval_Stats}"
                    }
                },
                {
                    "Header": "[Max.\n(km/h)]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowMaxSpeed_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.MaxSpeed, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Best lap]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowBestLap_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.FastestLapTime, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[On]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowBestLap_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.FastestLapNumLap, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[With]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Tyre_FL_Stats",
                        "RenderIf": "{ShowBestLapTyres_Stats}"
                    }
                },
                {
                    "Header": "[S1]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowBestLapSector_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.FastestLapSector1}"
                            }
                        }
                    }
                },
                {
                    "Header": "[S2]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowBestLapSector_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.FastestLapSector2}"
                            }
                        }
                    }
                },
                {
                    "Header": "[S3]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowBestLapSector_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.FastestLapSector3}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Driver\npoints]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowPoints_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.DriverPoints, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
                {
                    "Header": "[Team\npoints]",
                    "Template": {
                        "BlockType": "component",
                        "Component": "Generic_Stats",
                        "RenderIf": "{ShowPoints_Stats}",
                        "ComponentOptions": {
                            "Vars": {
                                "data": "{Item.TeamPoints, Converter=NumberZeroToEmpty}"
                            }
                        }
                    }
                },
            ]
        }
    },
