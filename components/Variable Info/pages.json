[
    //Session
    {
        "ComponentName": "MediaSession_VariableInfo_P2",
        "BlockType": "canvas",
        "Width": 1200,
        "Height": 1500,
        "Items": [
            {
                "BlockType": "itemstack",
                "PositionX": 90,
                "PositionY": 60,
                "Orientation": "Vertical",
                "Spacing": 1,
                "Triggers": [
                    {
                        "Condition": "{SingleStatsSession_{Media_SessionInfo}}",
                        "ConditionValue": "mili_asc",
