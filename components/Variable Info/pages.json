                        "Value": "{Media_SessionInfo}Ms"
                    },
                    {
                        "Condition": "{SingleStatsSession_{Media_SessionInfo}}",
                        "ConditionValue": "mili_desc",
                        "Property": "ItemStackOptions.OrderByDescending",
                        "Value": "{Media_SessionInfo}Ms"
                    },
                    {
                        "Condition": "{SingleStatsSession_{Media_SessionInfo}}",
                        "ConditionValue": "stat_asc",
                        "Property": "ItemStackOptions.OrderBy",
                        "Value": "{Media_SessionInfo}"
                    },
                    {
                        "Condition": "{SingleStatsSession_{Media_SessionInfo}}",
                        "ConditionValue": "stat_desc",
                        "Property": "ItemStackOptions.OrderByDescending",
                        "Value": "{Media_SessionInfo}"
                    },
                    {
                        "Trigger": "MediaTablePage_stats"
                    }
                ],
                "ItemStackOptions": {
                    "ItemSource": "{Session.Drivers}",
                    "IndexStart": 8,
                    "Limit": 23,
                    "ItemTemplate": {
                        "BlockType": "stack",
                        "Items": [
                            {
                                "BlockType": "component",
                                "Component": "VariableInfo_SessionItem2"
                            }
                        ]
                    }
                }
            }
        ]
    },
