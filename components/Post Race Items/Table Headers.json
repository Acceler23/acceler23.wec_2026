[
    //Race Head
    {
        "ComponentName": "RaceHeadTable",
        "BlockType": "stack",
        "Orientation": "Vertical",
        "Spacing": -10,
        "Width": 1142,
        "Items": [
            {
                "BlockType": "dock",
                "Orientation": "Horizontal",
                "Items": [
                    {
                        "BlockType": "stack",
                        "Orientation": "Horizontal",
                        "HorizontalAlignment": "Left",
                        "VerticalAlignment": "Center",
                        "Spacing": -2,
                        "Items": [
                            {
                                "BlockType": "text",
                                "Source": "[{Session.SessionType, Converter=StringToUpperString}]",
                                "FontName": "{Druk_Medium_Itallic}",
                                "FontSize": 80,
                                "Padding": "5",
                                "Foreground": "{white}"
                            },
                            {
                                "BlockType": "text",
                                "Source": "[CLASSIFICATION]",
                                "FontName": "{Druk_Medium_Itallic}",
                                "FontSize": 80,
                                "Padding": "5",
                                "Foreground": "{white}"
                            },
                            {
                                "BlockType": "text",
                                "Source": "[RESULTS]",
                                "FontName": "{Druk_Medium_Itallic}",
                                "FontSize": 80,
                                "Padding": "5",
                                "Foreground": "{lightBlue}"
                            }
                        ]
                    },
                    {
                        "BlockType": "image",
                        "Source": "rolex",
                        "Height": 70,
                        "HorizontalAlignment": "Right",
                        "VerticalAlignment": "Top",
                        "MarginRight": 20
                    }
                ]
            },
            {
                "BlockType": "shape",
                "Opacity": 80,
                "Width": 1142,
                "Height": 3,
                "ShapeOptions": {
                    "Fill": "{lightBlue}",
                    "ShapeType": "ellipse"
                }
            },
            {
                "BlockType": "dock",
                "Orientation": "Horizontal",
                "MarginTop": 44,
                "Height": 40,
                "HorizontalAlignment": "Right",
                "Width": 1125,
                "Items": [
                    {
                        "BlockType": "text",
                        "RenderIf": "{Session.IsHaveRacingClass}",
                        "Source": "[{Session.RacingClass.Name, Converter=StringToUpperString}]",
                        "Background": "{Session.RacingClass.Color}",
                        "Foreground": "{Session.RacingClass.SecondaryColor}",
                        "FontName": "{DrukWide_Medium_Italic}",
                        "Height": 40,
                        "FontSize": 29,
                        "Margin": "8,2,0,0",
                        "VerticalAlignment": "Center",
                        "HorizontalAlignment": "Left",
                        "Padding": "7,5,7,0",
                        "Triggers": [
                            {
                                "Condition": "{Recolor_WEC}",
                                "ConditionAnd": "{Session.IsHaveRacingClass}",
                                "Setters": [
                                    {
                                        "Property": "Background",
                                        "Value": "{{Session.RacingClass.FirstFactor.CarClass.Name}_Color}"
                                    },
                                    {
                                        "Property": "Foreground",
                                        "Value": "{white}"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "BlockType": "text",
                        "Source": "[{Session.Track.CircuitFullName, Converter=StringToUpperString}]",
                        "Foreground": "{white}",
                        "FontName": "{DrukWide_Medium_Italic}",
                        "Height": 40,
                        "FontSize": 29,
                        "Margin": "0,2,0,0",
                        "VerticalAlignment": "Center",
                        "HorizontalAlignment": "Right",
                        "Padding": "7,5,7,0",

                        "Triggers": [
                            { "Trigger": "WEC_TrackName_Session" }
                        ]
                    }
                ]
            }
        ]
    },
    //Qualy Head
    {
        "ComponentName": "QualyHeadTable",
        "BlockType": "stack",
        "Orientation": "Vertical",
        "Spacing": -10,
        "Width": 1142,
        "Items": [
            {
                "BlockType": "dock",
                "Orientation": "Horizontal",
                "Items": [
                    {
                        "BlockType": "stack",
                        "Orientation": "Horizontal",
                        "HorizontalAlignment": "Left",
                        "VerticalAlignment": "Center",
                        "Spacing": -2,
                        "Items": [
                            {
                                "BlockType": "text",
                                "Source": "[{Session.SessionType, Converter=StringToUpperString}]",
                                "FontName": "{Druk_Medium_Itallic}",
                                "FontSize": 80,
                                "Padding": "5",
                                "Foreground": "{white}",
                                "Triggers": [
                                    {
                                        "Condition": "{Session.SessionTypeString}",
                                        "ConditionValue": "Q2",
                                        "Property": "Source",
                                        "Value": "[HYPERPOLE]"
                                    }
                                ]
                            },
                            {
                                "BlockType": "text",
                                "Source": "[{Session.RacingClass.Name, Converter=StringToUpperString}]",
                                "FontName": "{Druk_Medium_Itallic}",
                                "FontSize": 80,
                                "Padding": "5",
                                "Foreground": "{white}",
                                "Triggers": [
                                    {
                                        "Condition": "{Session.RacingClass.Name, Converter=EmptyObjectToTrue}",
                                        "Property": "Source",
                                        "Value": "[OVERALL]"
                                    }
                                ]
                            },
                            {
                                "BlockType": "text",
                                "Source": "[CLASSIFICATION]",
                                "FontName": "{Druk_Medium_Itallic}",
                                "FontSize": 80,
                                "Padding": "5",
                                "Foreground": "{white}"
                            },
                            {
                                "BlockType": "text",
                                "Source": "[RESULTS]",
                                "FontName": "{Druk_Medium_Itallic}",
                                "FontSize": 80,
                                "Padding": "5",
                                "Foreground": "{lightBlue}"
                            }
                        ]
                    }
                ]
            },
            {
                "BlockType": "shape",
                "Opacity": 80,
                "Width": 1142,
                "Height": 3,
                "ShapeOptions": {
                    "Fill": "{lightBlue}",
                    "ShapeType": "ellipse"
                }
            },
            {
                "BlockType": "dock",
                "Orientation": "Horizontal",
                "MarginTop": 20,
                "Height": 64,
                "HorizontalAlignment": "Right",
                "Width": 1125,
                "Items": [
                    {
                        "BlockType": "text",
                        "Source": "[{Session.RacingClass.Name, Converter=StringToUpperString}]",
                        //"Background": "{Session.RacingClass.Color}",
                        "Foreground": "{Session.RacingClass.SecondaryColor}",
                        "FontName": "{DrukWide_Medium_Italic}",
                        "BackgroundImage": "PostRace/logo_bg",
                        "ColorizeBackground": {
                            "Color": "{Session.RacingClass.Color}"
                        },
                        "Height": 40,
                        "FontSize": 29,
                        "Margin": "9,2,0,0",
                        "VerticalAlignment": "Center",
                        "HorizontalAlignment": "Left",
                        "Padding": "7,5,7,5",
                        "Triggers": [
                            {
                                "Condition": "{Recolor_WEC}",
                                "ConditionAnd": "{Session.IsHaveRacingClass}",
                                "Setters": [
                                    {
                                        "Property": "ColorizeBackground.Color",
                                        "Value": "{{Session.RacingClass.FirstFactor.CarClass.Name}_Color}"
                                    },
                                    {
                                        "Property": "Foreground",
                                        "Value": "{white}"
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "BlockType": "text",
                        "Source": "[{Session.Track.CircuitFullName, Converter=StringToUpperString}]",
                        "Foreground": "{white}",
                        "FontName": "{DrukWide_Medium_Italic}",
                        "Height": 40,
                        "FontSize": 29,
                        "Margin": "0,2,0,0",
                        "VerticalAlignment": "Center",
                        "HorizontalAlignment": "Right",
                        "Padding": "7,5,7,0",
                        "RenderIf": false,
                        "Triggers": [
                            {
                                "Condition": "{Session.SessionTypeString}",
                                "ConditionValue": "Regular",
                                "ConditionOr": "{Session.SessionTypeString}",
                                "ConditionOrValue": "Q2",
                                "Property": "RenderIf",
                                "Value": true
                            },
                            { "Trigger": "WEC_TrackName_Session" }
                        ]
                    },
                    {
                        "BlockType": "stack",
                        "Orientation": "Horizontal",
                        "HorizontalAlignment": "Right",
                        "RenderIf": false,
                        "Triggers": [
                            {
                                "Condition": "{Session.SessionTypeString}",
                                "ConditionValue": "Q1",
                                "ConditionAnd": "{TablePage}",
                                "ConditionAndValue": 1,
                                "Property": "RenderIf",
                                "Value": true
                            }
                        ],
                        "Items": [
                            {
                                "BlockType": "text",
                                "Source": "[QUALIFIED FOR]",
                                "Foreground": "{white}",
                                "FontName": "{DrukWide_Medium_Italic}",
                                "Height": 40,
                                "FontSize": 29,
                                "Margin": "0,5,20,0",
                                "VerticalAlignment": "Center",
                                "HorizontalAlignment": "Right",
                                "Padding": "7,5,7,0"
                            },
                            {
                                "BlockType": "canvas",
                                "Orientation": "Horizontal",
                                "BackgroundImage": "PostRace/hyperpole_bg",
                                "Height": 62,
                                "Width": 427,
                                "Items": [
                                    {
                                        "BlockType": "text",
                                        "Source": "[HYPERPOLE]",
                                        "Foreground": "{white}",
                                        "FontName": "{DrukWide_Medium_Italic}",
                                        "FontSize": 29,
                                        "PositionX": 45,
                                        "PositionY": 18,
                                        "Padding": "5"
                                    },
                                    {
                                        "BlockType": "image",
                                        "Source": "rolex_clean",
                                        "PositionX": 333,
                                        "PositionY": 10,
                                        "Height": 43,
                                        "Colorize": {
                                            "Color": "{RolexColor}"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "BlockType": "stack",
                        "Orientation": "Horizontal",
                        "HorizontalAlignment": "Right",
                        "RenderIf": false,
                        "MarginTop": 10,
                        "Triggers": [
                            {
                                "Condition": "{Session.SessionTypeString}",
                                "ConditionValue": "Q1",
                                "ConditionAnd": "{TablePage, Converter=NumberGreater, Parameter=1}",
                                "Property": "RenderIf",
                                "Value": true
                            }
                        ],
                        "Items": [
                            {
                                "BlockType": "dock",
                                "Orientation": "Horizontal",
                                "BackgroundImage": "PostRace/eliminated_bg",
                                "Height": 51,
                                "Items": [
                                    {
                                        "BlockType": "text",
                                        "Source": "[ELIMINATED]",
                                        "Foreground": "{white}",
                                        "FontName": "{DrukWide_Medium_Italic}",
                                        "FontSize": 20,
                                        "Padding": "30, 15, 30, 15",
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Center"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    },
