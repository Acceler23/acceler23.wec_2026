[
    {
        "ComponentName": "DriverLine",
        "BlockType": "stack",
        "Orientation": "Horizontal",
        "Background": "{darkPurple}",
        "Width": "*",
        "Height": 50,
        "Triggers": [
            { "Trigger": "TeamColor_BackgroundP1" },
            { "Trigger": "CarColor_BackgroundP1" },
            { "Trigger": "WEC_Team_BackgroundP1" },
            { "Trigger": "WEC_Car_BackgroundP1" }
        ],
        "Items": [
            {
                "BlockType": "text",
                "Source": "[{Item.Driver.{DriverName}, Converter=StringToUpperString}]",
                "Style": "DriverLineStyle",
                "RenderIf": true,
                "Triggers": [
                    {
                        "Condition": "{DriverName}",
                        "ConditionValue": "Short First Name",
                        "ConditionOr": "{DriverName}",
                        "ConditionOrValue": "RealName",
                        "Property": "RenderIf",
                        "Value": false
                    },
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" },
                ]
            },
            {
                "BlockType": "text",
                "Source": "[{Item.Driver.FirstName, Converter=StringToUpperString}]",
                "Style": "DriverLineStyle",
                "RenderIf": false,
                "Triggers": [
                    {
                        "Condition": "{DriverName}",
                        "ConditionValue": "RealName",
                        "Property": "RenderIf",
                        "Value": true
                    },
                    {
                        "Condition": "{DriverName}",
                        "ConditionValue": "Short First Name",
                        "Setters": [
                            {
                                "Property": "RenderIf",
                                "Value": true
                            },
                            {
                                "Property": "Source",
                                "Value": "[{Item.Driver.FirstName, Converter=MaxStringLength, Parameter=1}]."
                            }
                        ]
                    },
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" }
                ]
            },
            {
                "BlockType": "text",
                "Source": "[{Item.Driver.LastName, Converter=StringToUpperString}]",
                "Style": "DriverLineStyle",
                "MarginLeft": -35,
                "FontName": "{Archivo_SemiExpanded_BoldItallic}",
                "TextOptions": {
                    "FontStyle": "BoldItalic"
                },
                "RenderIf": false,
                "Triggers": [
                    {
                        "Condition": "{DriverName}",
                        "ConditionValue": "Short First Name",
                        "ConditionOr": "{DriverName}",
                        "ConditionOrValue": "RealName",
                        "Property": "RenderIf",
                        "Value": true
                    },
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" }
                ]
            },
            {
                "BlockType": "shape",
                "Width": 1,
                "Height": 50,
                "Opacity": 0
            }
        ]
    },
    {
        "ComponentName": "TeamLine",
        "BlockType": "stack",
        "Orientation": "Horizontal",
        "Background": "{darkPurple}",
        "Height": 50,
        "Width": "*",
        "Triggers": [
            { "Trigger": "TeamColor_BackgroundP1" },
            { "Trigger": "CarColor_BackgroundP1" },
            { "Trigger": "WEC_Team_BackgroundP1" },
            { "Trigger": "WEC_Car_BackgroundP1" },
        ],
        "Items": [
            {
                "BlockType": "text",
                "Source": "[{Item.Team.FullName, Converter=StringToUpperString}]",
                "Style": "DriverLineStyle",
                "Triggers": [
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "Team_FullName" },
                    { "Trigger": "Car_FullName" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" },
                ]
            },
            {
                "BlockType": "shape",
                "Width": 1,
                "Height": 50,
                "Opacity": 0
            }
        ]
    },
    {
        "ComponentName": "ShortCarName",
        "BlockType": "stack",
        "Orientation": "Horizontal",
        "Background": "{darkPurple}",
        "Height": 50,
        "Width": "*",
        "Triggers": [
            { "Trigger": "TeamColor_BackgroundP1" },
            { "Trigger": "CarColor_BackgroundP1" },
            { "Trigger": "WEC_Team_BackgroundP1" },
            { "Trigger": "WEC_Car_BackgroundP1" }
        ],
        "Items": [
            {
                "BlockType": "text",
                "Width": 80,
                //"Source": "[{{Item.Car.Vendor.Name, Converter=MaxStringLength, Parameter=3}, Converter=StringToUpperString}]",
                "Style": "DriverLineStyle",
                "FontName": "{Archivo_Black_Itallic}",
                "TextOptions": {
                    "FontStyle": "BoldItalic"
                },
                "Triggers": [
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" },
                    {
                        "Condition": "{Season.LineupsBasedType}",
                        "ConditionValue": "Teams",
                        "ConditionAnd": "{Item.Team.Car.Vendor.Name, Converter=EmptyObjectToFalse}",
                        "Property": "Source",
                        "Value": "[{{Item.Team.Car.Vendor.Name, Converter=MaxStringLength, Parameter=3}, Converter=StringToUpperString}]"
                    },
                    {
                        "Condition": "{Season.LineupsBasedType}",
                        "ConditionValue": "Cars",
                        "ConditionAnd": "{Item.Team.Car.Vendor.Name, Converter=EmptyObjectToTrue}",
                        "Property": "Source",
                        "Value": "[{{Item.Car.Vendor.Name, Converter=MaxStringLength, Parameter=3}, Converter=StringToUpperString}]"
                    }
                ]
            },
            {
                "BlockType": "shape",
                "Width": 1,
                "Height": 50,
                "Opacity": 0
            }
        ]
    },
    {
        "ComponentName": "RaceNumberLine",
        "BlockType": "dock",
        "Orientation": "Horizontal",
        "Background": "{darkPurple}",
        "Height": 50,
        "Width": 78,
        "Triggers": [
            { "Trigger": "TeamColor_BackgroundP1" },
            { "Trigger": "CarColor_BackgroundP1" },
            { "Trigger": "WEC_Team_BackgroundP1" },
            { "Trigger": "WEC_Car_BackgroundP1" },
        ],
        "Items": [
            {
                "BlockType": "text",
                "Source": "[{Item.{CarNumber}}]",
                "Style": "DriverLineStyle",
                "FontName": "{Archivo_Black_Itallic}",
                "HorizontalAlignment": "Center",
                "FontSize": "{30, Converter=NumberSubtract, Parameter={{Item.{CarNumber}, Converter=GetStringLength}, Converter=NumberMultiply, Parameter=1.4}}",
                "Triggers": [
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" },
                    {
                        "Condition": "<isTeam>",
                        "ConditionAnd": "{Season.LineupsBasedType}",
                        "ConditionAndValue": "Teams",
                        "Setters": [
                            {
                                "Property": "Source",
                                "Value": "[{Item.Team.Abbreviation}]"
                            },
                            {
                                "Property": "FontSize",
                                "Value": 20
                            }
                        ]
                    }
                ]
            },
            {
                "BlockType": "shape",
                "Width": 1,
                "Height": 50,
                "Opacity": 0
            }
        ]
    },
    {
        "ComponentName": "tableColorShape",
        "BlockType": "shape",
        "Height": 50,
        "Width": 5,
        "ShapeOptions": {
            "Fill": "{white}"
        },
        "Triggers": [
            { "Trigger": "TeamColor_ShapeFill" },
            { "Trigger": "CarColor_ShapeFill" },
            { "Trigger": "WEC_Team_ShapeMain" },
            { "Trigger": "WEC_Car_ShapeMain" }
        ]
    },
    {
        "ComponentName": "tableLogo",
        "Height": 50,
        "BlockType": "canvas",
        "Items": [
            {
                "BlockType": "dock",
                "Height": "{TableLineHeight}",
                "Width": 58,
                "BackgroundImage": "PostRace/logo_bg",
                "ColorizeBackground": {
                    "Color": "{white}"
                },
                "Triggers": [
                    { "Trigger": "CarColor_ImageBg" },
                    { "Trigger": "TeamColor_ImageBg" },
                    { "Trigger": "WEC_Team_ImageBG" },
                    { "Trigger": "WEC_Car_ImageBG" }
                ],
                "Items": [
                    {
                        "BlockType": "image",
                        "Height": 40,
                        "HorizontalAlignment": "Center",
                        "VerticalAlignment": "Center",
                        "Triggers": [
                            { "Trigger": "Car_LogotypeDefault" },
                            { "Trigger": "Team_LogotypeVendor" },
                            { "Trigger": "Team_LogotypeDefault" },
                            { "Trigger": "WEC_Car_Logotype" },
                            { "Trigger": "WEC_Team_Logotype" },
                            { "Trigger": "WEC_TeamSession_Logotype" },

                        ]
                    }
                ]
            },
            {
                "BlockType": "shape",
                "Width": 1,
                "Height": 50,
                "Opacity": 0
            }
        ]
    }
]