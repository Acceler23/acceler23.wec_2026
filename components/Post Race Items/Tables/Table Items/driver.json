[
    {
        "ComponentName": "DriverLine",
        "BlockType": "stack",
        "Orientation": "Horizontal",
        "Background": "{darkPurple}",
        "Width": "*",
        "Triggers": [
            { "Trigger": "TeamColor_BackgroundP1" },
            { "Trigger": "CarColor_BackgroundP1" },
            { "Trigger": "WEC_Team_BackgroundP1" },
            { "Trigger": "WEC_Car_BackgroundP1" },
        ],
        "Items": [
            {
                "BlockType": "text",
                "Source": "[{Item.Driver.{DriverName}, Converter=StringToUpperString}]",
                "Style": "DriverLineStyle",
                "Triggers": [
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" },
                ]
            }
        ]
    },
    {
        "ComponentName": "TeamLine",
        "BlockType": "stack",
        "Orientation": "Horizontal",
        "Background": "{darkPurple}",
        "Width": "*",
        "Triggers": [
            { "Trigger": "TeamColor_BackgroundP1" },
            { "Trigger": "CarColor_BackgroundP1" },
            { "Trigger": "WEC_Team_BackgroundP1" },
            { "Trigger": "WEC_Car_BackgroundP1" },
        ],
        "Items": [
            {
                "BlockType": "text",
                "Source": "[{Item.Team.FullName, Converter=StringToUpperString}]",
                "Style": "DriverLineStyle",
                "Triggers": [
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "Team_FullName" },
                    { "Trigger": "Car_FullName" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" },
                ]
            }
        ]
    },
    {
        "ComponentName": "ShortCarName",
        "BlockType": "stack",
        "Orientation": "Horizontal",
        "Background": "{darkPurple}",
        "Width": "*",
        "Triggers": [
            { "Trigger": "TeamColor_BackgroundP1" },
            { "Trigger": "CarColor_BackgroundP1" },
            { "Trigger": "WEC_Team_BackgroundP1" },
            { "Trigger": "WEC_Car_BackgroundP1" },
        ],
        "Items": [
            {
                "BlockType": "text",
                "Width": 80,
                "Source": "[{Item.Car.Vendor.Name} Short]",
                "Style": "DriverLineStyle",
                "FontName": "{CardTeamNameFont}",
                "TextOptions": {
                    "FontStyle": "BoldItalic"
                },
                "Triggers": [
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" },
                    {
                        "Condition": "{Season.LineupsBasedType}",
                        "ConditionValue": "Teams",
                        "Property": "Source",
                        "Value": "[{Item.Team.Car.Vendor.Name} Short]"
                    }
                ]
            }
        ]
    },
    {
        "ComponentName": "RaceNumberLine",
        "BlockType": "dock",
        "Orientation": "Horizontal",
        "Background": "{darkPurple}",
        "Width": 78,
        "Triggers": [
            { "Trigger": "TeamColor_BackgroundP1" },
            { "Trigger": "CarColor_BackgroundP1" },
            { "Trigger": "WEC_Team_BackgroundP1" },
            { "Trigger": "WEC_Car_BackgroundP1" },
        ],
        "Items": [
            {
                "BlockType": "text",
                "Source": "[{Item.{CarNumber}}]",
                "Style": "DriverLineStyle",
                "FontName": "{RaceNumberFont}",
                "HorizontalAlignment": "Center",
                "Triggers": [
                    { "Trigger": "TeamColor_ForegroundP1" },
                    { "Trigger": "CarColor_ForegroundP1" },
                    { "Trigger": "WEC_Team_ForegroundP1" },
                    { "Trigger": "WEC_Car_ForegroundP1" },
                    {
                        "Condition": "<isTeam>",
                        "ConditionAnd": "{Season.LineupsBasedType}",
                        "ConditionAndValue": "Teams",
                        "Setters": [
                            {
                                "Property": "Source",
                                "Value": "[{Item.Team.Abbreviation}]"
                            },
                            {
                                "Property": "FontSize",
                                "Value": 20
                            }
                        ]
                    }
                ]
            }
        ]
    },
    {
        "ComponentName": "tableColorShape",
        "BlockType": "shape",
        "Height": 50,
        "Width": 5,
        "ShapeOptions": {
            "Fill": "{white}"
        },
        "Triggers": [
            { "Trigger": "TeamColor_ShapeFill" },
            { "Trigger": "CarColor_ShapeFill" },
            { "Trigger": "WEC_Team_ShapeMain" },
            { "Trigger": "WEC_Car_ShapeMain" }
        ]
    },
    {
        "ComponentName": "tableLogo",
        "BlockType": "dock",
        "Height": "{TableLineHeight}",
        "Width": 58,
        "BackgroundImage": "PostRace/logo_bg",
        "ColorizeBackground": {
            "Color": "{white}"
        },
        "Triggers": [
            { "Trigger": "CarColor_ImageBg" },
            { "Trigger": "TeamColor_ImageBg" },
            { "Trigger": "WEC_Team_ImageBG" },
            { "Trigger": "WEC_Car_ImageBG" },
        ],
        "Items": [
            {
                "BlockType": "image",
                "Height": 40,
                "HorizontalAlignment": "Center",
                "VerticalAlignment": "Center",
                "Triggers": [
                    { "Trigger": "Car_LogotypeDefault" },
                    { "Trigger": "Team_LogotypeVendor" },
                    { "Trigger": "WEC_Car_Logotype" },
                    { "Trigger": "WEC_Team_Logotype" },
                ]
            }
        ]
    }
]