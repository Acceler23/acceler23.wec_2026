[
    //race
    {
        "ComponentName": "MediaTable_RaceItem",
        "BlockType": "canvas",
        "Items": [
            {
                "BlockType": "image",
                "Source": "Media_items/race/odd_bg.png",
                "Width": 1058,
                "Height": 165,
                "Triggers": [
                    {
                        "Condition": "{Item.Index, Converter=NumberIsOdd}",
                        "Property": "Source",
                        "Value": "Media_items/race/even_bg.png"
                    }
                ]
            },
            {
                "BlockType": "image",
                "Source": "Media_items/race/colorShape.png",
                "Width": 1058,
                "Height": 165,
                "Triggers": [
                    { "Trigger": "CarColor_ImageColorize" },
                    { "Trigger": "TeamColor_ImageColorize" },
                    { "Trigger": "WEC_CarColor_ImageColorize" },
                    { "Trigger": "WEC_TeamColor_ImageColorize" }
                ],
                "Colorize": {
                    "Color": "{white}"
                }
            },
            {
                "BlockType": "image",
                "Source": "Media_items/race/star.png",
                "Width": 1058,
                "Height": 165
            },
            {
                "BlockType": "dock",
                "PositionX": 23,
                "PositionY": 8,
                "Height": 147,
                "Width": 170,
                "Items": [
                    {
                        "BlockType": "text",
                        "Source": "P{Item.Position}",
                        "HorizontalAlignment": "Center",
                        "VerticalAlignment": "Top",
                        "Foreground": "{white}",
                        "FontName": "{Druk_Medium}",
                        "FontSize": 94,
                        "PaddingTop": 93,
                        "Triggers": [
                            {
                                "Condition": "{Item.IsFinished, Converter=BoolReverse}",
                                "Property": "Source",
                                "Value": "[{Item.Status, Converter=StringToUpperString}]"
                            }
                        ]
                    }
                ]
            },
            {
                "BlockType": "dock",
                "Orientation": "Horizontal",
                "PositionX": 240,
                "PositionY": 12,
                "Width": 140,
                "Height": 148,
                "Items": [
                    {
                        "BlockType": "text",
                        "Source": "[N°]",
                        "HorizontalAlignment": "Left",
                        "VerticalAlignment": "Center",
                        "Foreground": "{white}",
                        "FontName": "{Archivo_ExtraCondensed_Thin}",
                        "FontSize": 25,
                        "Opacity": 80
                    },
                    {
                        "BlockType": "text",
                        "Source": "{Item.{CarNumber}}",
                        "HorizontalAlignment": "Center",
                        "VerticalAlignment": "Center",
                        "Foreground": "{white}",
                        "FontName": "{Archivo_SemiExpanded_SemiBold_Itallic}",
                        "FontSize": 40,
                        "TextOptions": {
                            "FontStyle": "Italic"
                        }
                    }
                ]
            },
            {
                "BlockType": "dock",
                "PositionX": 395,
                "PositionY": 23,
                "Height": 125,
                "Width": 198,
                "Items": [
                    {
                        "BlockType": "image",
                        "Source": "{Item.Car.Vendor.LightLogotypePath}",
                        "HorizontalAlignment": "Center",
                        "VerticalAlignment": "Center",
                        "Height": 90,
                        "Triggers": [
                            { "Trigger": "Car_LogotypeLight" },
                            { "Trigger": "Team_LogotypeLight" },
                            { "Trigger": "Team_LogotypeVendorLight" },
                            { "Trigger": "WEC_Car_LightLogotype" },
                            { "Trigger": "WEC_Team_LightLogotype" },
                            { "Trigger": "WEC_TeamSession_LightLogotype" }
                        ]
                    }
                ]
            },
            {
                "BlockType": "dock",
                "PositionX": 640,
                "PositionY": 23,
                "Height": 125,
                "Width": 312,
                "Items": [
                    {
                        "BlockType": "text",
                        "Source": "{Item.Driver.{DriverName}, Converter=StringToUpperString}",
                        "HorizontalAlignment": "Left",
                        "VerticalAlignment": "Center",
                        "Width": 312,
                        "Height": 125,
                        "FontSize": 24,
                        "FontName": "{Archivo_SemiExpanded_Bold}",
                        "Foreground": "{white}",
                        "Padding": "5",
                        "TextOptions": {
                            "FontStyle": "Bold",
                            "Wrap": true
                        },
                        "Triggers": [
                            {
                                "Condition": "{Render_DriverTeam}",
                                "ConditionAnd": "{Season.LineupsBasedType}",
                                "ConditionAndValue": "Teams",
                                "Property": "Source",
                                "Value": "{Item.Team.FullName, Converter=StringToUpperString}"
                            },
                            {
                                "Condition": "{Render_DriverTeam}",
                                "ConditionAnd": "{Season.LineupsBasedType}",
                                "ConditionAndValue": "Cars",
                                "Property": "Source",
                                "Value": "{Item.Car.Name, Converter=StringToUpperString}"
                            }
                        ]
                    }
                ]
            }
        ]
    },
