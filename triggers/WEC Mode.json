        "Value": "{{Item.Team.Car.Vendor.Name}_Color}"
    },
    {
        "TriggerName": "WEC_Car_ColorBG",
        "Condition": "{WEC_color}",
        "ConditionAnd": "{Season.LineupsBasedType, Converter=EnumEquals, Parameter=Cars}",
        "Property": "Background",
        "Value": "{{Item.Car.Vendor.Name}_Color}"
    },

