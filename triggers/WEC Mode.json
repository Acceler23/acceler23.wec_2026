                "Value": "{{Standings.LastEvent.Track.CircuitOrigin}_LineSpace}"
            }
        ]
    },
    {
        "TriggerName": "WEC_TrackName_Calendar",
        "Condition": "{WEC_Tracks}",
        "Property": "Source",
        "Value": "{{Item.Track.CircuitOrigin}_EventName}"
    },
    {
        "TriggerName": "WEC_TrackName_CardHead_Calendar",
