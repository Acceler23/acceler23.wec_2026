        "Property": "Source",
        "Value": "{{Session.Track.CircuitOrigin}_EventName}"
    },
    {
        "TriggerName": "WEC_TrackName_CardHead_Session",
        "Condition": "{WEC_Tracks}",
        "Setters": [
            {
                "Property": "Source",
                "Value": "{{Session.Track.CircuitOrigin}_EventName}"
            },
            {
                "Property": "FontSize",
                "Value": "{{Session.Track.CircuitOrigin}_FontSize}"
            },
            {
