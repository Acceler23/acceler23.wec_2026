{
    "BlockRoot": {
        "Name": "mainStack",
        "BlockType": "stack",
        "Orientation": "Vertical",
        "Width": 1200,
        "Items": [
            {
                "BlockType": "stack",
                "Width": 1200,
                "PaddingTop": 75,
                "Items": [
                    {
                        "BlockType": "canvas",
                        "HorizontalAlignment": "Left",
                        "Items": [
                            {
                                "BlockType": "image",
                                "Source": "Media_items/calendar/leader_info",
                                "PositionX": -550,
                                "Height": 110,
                                "Width": 900,
                                "Colorize": {
                                    "Color": "{darkPurple}"
                                }
                            },
                            {
                                "BlockType": "dock",
                                "Width": 350,
                                "Height": 110,
                                //"Background": "#dddddd",
                                "Items": [
                                    {
                                        "BlockType": "image",
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Left",
                                        "Source": "{Season.LeagueInfo.LeagueLogo}",
                                        "Width": 300,
                                        "Opacity": 10,
                                        "Colorize": {
                                            "Color": "{white}",
                                            "ColorBlendingMode": "HardLight",
                                            "BlendPercentage": 50
                                        }
                                    }
                                ]
                            },
                            {
                                "BlockType": "dock",
                                "Width": 320,
                                "Height": 110,
                                //"Background": "#dddddd",
                                "Items": [
                                    {
                                        "BlockType": "image",
                                        "Source": "{Season.LogotypePath}",
                                        "Height": 100,
                                        "HorizontalAlignment": "Right",
                                        "VerticalAlignment": "Center"
                                    }
                                ]
                            },
                            {
                                "BlockType": "image",
                                "Source": "Media_items/calendar/triangle",
                                "PositionY": 50,
                                "PositionX": 355,
                                "Height": 15,
                                "Width": 5,
                                "Colorize": {
                                    "Color": "{white}"
                                }
                            }
                        ]
                    },
                    {
                        "BlockType": "stack",
                        "PaddingLeft": 30,
                        "PaddingRight": 75,
                        "PaddingTop": 10,
                        "Spacing": 10,
                        "HorizontalAlignment": "Right",
                        "Orientation": "Horizontal",
                        "Items": [
                            {
                                "BlockType": "text",
                                "Source": "[{Season.MainLeagueCategory.ShortName, Converter=StringToUpperString}]",
                                "FontName": "{Druk_Bold}",
                                "VerticalAlignment": "Center",
                                "FontSize": 120,
                                "PaddingTop": 20,
                                "Width": "*",
                                "Foreground": "{lightBlue}"
                            },
                            {
                                "BlockType": "text",
                                "Source": "[CALENDAR]",
                                "FontName": "{Druk_Bold}",
                                "VerticalAlignment": "Center",
                                "FontSize": 120,
                                "PaddingTop": 20,
                                "Foreground": "{white}",
                                "Width": "*"
                            }
                        ]
                    }
                ]
            },
            {
                "BlockType": "itemstack",
                "Orientation": "Vertical",
                "Spacing": 10,
                "Padding": "120, 50",
                "ItemStackOptions": {
                    "ItemSource": "{Events.Events}",
                    "ItemTemplate": {
                        "BlockType": "canvas",
                        "Items": [
                            {
                                "BlockType": "image",
                                "Source": "Media_items/calendar/calendar_type1",
                                "Height": 110,
                                "Triggers": [
                                    {
                                        "Condition": "{Item.Index, Converter=NumberIsOdd}",
                                        "Property": "Source",
                                        "Value": "Media_items/calendar/calendar_type2"
                                    }
                                ]
                            },
                            {
                                "BlockType": "dock",
                                "PositionX": -100,
                                "Width": 600,
                                "Height": 110,
                                //"Background": "#dddddd",
                                "Items": [
                                    {
                                        "BlockType": "image",
                                        "RenderIf": false,
                                        "Source": "{Season.LogotypePath}",
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Left",
                                        "Width": 600,
                                        "Opacity": 10,
                                        "Colorize": {
                                            "Color": "{white}",
                                            "ColorBlendingMode": "HardLight",
                                            "BlendPercentage": 50
                                        },
                                        "Triggers": [
                                            {
                                                "Condition": "{Item.Index, Converter=NumberIsEven}",
                                                "Property": "RenderIf",
                                                "Value": true
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "BlockType": "text",
                                "PositionX": 50,
                                "PositionY": 30,
                                "Source": "[R]{Item.Position, Converter=NumberSubtract, Parameter={Season.SeasonOverallNumberEvents, Converter=NumberSubtract, Parameter={Season.SeasonOverallNumberEventsExcludingNonChampionship}}}",
                                "FontName": "{DrukWide_Bold_Itallic}",
                                "Padding": "10",
                                "Foreground": "{white}",
                                "FontSize": 45,
                                "TextOptions": {
                                    "TextAlignment": "Start"
                                },
                                "Triggers": [
                                    {
                                        "Condition": "{Item.IsChampionshipStatus, Converter=BoolReverse}",
                                        "Setters": [
                                            {
                                                "Property": "Source",
                                                "Value": "[OFFICIAL\nPROLOGUE]"
                                            },
                                            {
                                                "Property": "TextOptions.TextAlignment",
                                                "Value": "Center"
                                            },
                                            {
                                                "Property": "FontSize",
                                                "Value": 17
                                            },
                                            {
                                                "Property": "PositionX",
                                                "Value": 50
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "BlockType": "dock",
                                "Height": 70,
                                "Width": 110,
                                "PositionX": 180,
                                "PositionY": 20,
                                "Items": [
                                    {
                                        "BlockType": "image",
                                        "Source": "country/{Item.Track.Nation.Name}",
                                        "Height": 50,
                                        "HorizontalAlignment": "Center",
                                        "VerticalAlignment": "Center"
                                    }
                                ]
                            },
                            {
                                "BlockType": "image",
                                "Source": "Media_items/calendar/triangle",
                                "Height": 10,
                                "PositionX": 300,
                                "PositionY": 50
                            },
                            {
                                "BlockType": "dock",
                                "Height": 110,
                                "PositionX": 330,
                                "PositionY": 5,
                                "Items": [
                                    {
                                        "BlockType": "stack",
                                        "Orientation": "Vertical",
                                        "VerticalAlignment": "Center",
                                        "Items": [
                                            {
                                                "BlockType": "text",
                                                "Source": "[{Item.Track.CountryName, Converter=StringToUpperString}]",
                                                "VerticalAlignment": "Center",
                                                "Width": 350,
                                                "FontName": "{Archivo_Expanded_ExtraBold}",
                                                "Padding": "0,5,10,0",
                                                "Foreground": "{white}",
                                                "FontSize": 28
                                            },
                                            {
                                                "BlockType": "text",
                                                "Width": 280,
                                                "Source": "[{Item.Track.CircuitFullName, Converter=StringToUpperString}]",
                                                "Foreground": "#90ffffff",
                                                "VerticalAlignment": "Center",
                                                "MarginTop": -10,
                                                "Padding": "0,15,10,0",
                                                "FontName": "{Archivo_Regular}",
                                                "FontSize": 18,
                                                "TextOptions": {
                                                    "Wrap": true,
                                                    "VerticalAlignment": "Top"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "BlockType": "dock",
                                "Width": 230,
                                "Orientation": "Vertical",
                                //"Background": "#dddddd",
                                "PositionX": 730,
                                "PositionY": 40,
                                "Items": [
                                    {
                                        "BlockType": "stack",
                                        "RenderIf": "{Item.CompletedStatus, Converter=EnumEquals, Parameter=InFuture}",
                                        "Orientation": "Horizontal",
                                        "HorizontalAlignment": "Center",
                                        "Items": [
                                            {
                                                "BlockType": "text",
                                                "VerticalAlignment": "Center",
                                                "Source": "[Calendar {Item.DateLocal, Converter=DateToMonthInWords}]",
                                                "FontName": "{Archivo_Expanded_ExtraBold}",
                                                "FontSize": 28,
                                                "Foreground": "{white}",
                                                "Padding": "5"
                                            },
                                            {
                                                "BlockType": "text",
                                                "MarginLeft": -3,
                                                "VerticalAlignment": "Center",
                                                "Source": "[day {Item.DateLocal, Converter=DateToDayOfMonth}]",
                                                "FontName": "{Archivo_Expanded_SemiBold}",
                                                "FontSize": 17,
                                                "Padding": "3",
                                                "Foreground": "{lightBlue}"
                                            }
                                        ]
                                    },
                                    {
                                        "BlockType": "text",
                                        "RenderIf": "{Item.CompletedStatus, Converter=EnumEquals, Parameter=Completed}",
                                        "VerticalAlignment": "Center",
                                        "HorizontalAlignment": "Center",
                                        "Source": "[{Item.WinnerString, Converter=StringToUpperString}]",
                                        "FontName": "{Archivo_SemiBold_Itallic}",
                                        "FontSize": 20,
                                        "Foreground": "{white}",
                                        "Padding": "5"
                                    }
                                ]
                            }
                        ]
                    }
                }
            }
        ]
    }
}