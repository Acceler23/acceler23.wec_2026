{
    "BlockRoot": {
        "BlockType": "dock",
        "Orientation": "Horizontal",
        "Margin": "{RenderMarginRace}",
        "Width": "{PostRaceWidth}",
        "MaxHeight": "{PostRaceHeight}",
        "Spacing": 28,
        "Items": [
            {
                "BlockType": "component",
                "Component": "RaceCard",
                "HorizontalAlignment": "Left",
                "VerticalAlignment": "Center",
                //"Margin": "60, 60, 0, 60"
            },
            {
                "BlockType": "stack",
                "HorizontalAlignment": "Right",
                "VerticalAlignment": "Center",
                "BackgroundImage": "PostRace/TableShade",
                "BackgroundImageOpacity": 70,
                "Orientation": "Vertical",
                //"Margin": "30, 60, 112, 60",
                "Width": 1370,
                "Height": 968,
                "Items": [
                    {
                        "BlockType": "component",
                        "Component": "RaceHeadTable",
                        "Margin": "115, 57, 115, 0"
                    },
                    {
                        "BlockType": "component",
                        "Component": "PostRaceTable_Results",
                        "Margin": "57, 24, 118, 0",
                        "Triggers": [
                            {
                                "Condition": "{Render_DriverTeam}",
                                "Setters": [
                                    {
                                        "ComponentVar": "renderDriver",
                                        "Value": false
                                    },
                                    {
                                        "ComponentVar": "renderTeam",
                                        "Value": true
                                    }
                                ]
                            }
                        ],
                        "ComponentOptions": {
                            "Vars": {
                                "renderDriver": true,
                                "renderTeam": false
                            }
                        }
                    },
                    {
                        "BlockType": "itemstack",
                        "Margin": "57, 22, 120, 0",
                        "ItemStackOptions": {
                            "ItemSource": "{Session.Drivers}",
                            "FilterMember": "Driver.Name",
                            "FilterMemberValue": "{Session.FastestLapDriver.Name}",
                            "ItemTemplate": {
                                "BlockType": "component",
                                "Component": "FastestLap"
                            }
                        }
                    },
                    {
                        "BlockType": "component",
                        "Component": "TableBottom",
                        "Margin": "70, 9, 115, 0",
                        "Triggers": [
                            {
                                "Condition": "{Session.FastestLapDriver.Name, Converter=EmptyObjectToTrue}",
                                "Property": "Margin",
                                "Value": "70, 81, 115, 0"
                            }
                        ]
                    }
                ]
            }
        ]
    }
}