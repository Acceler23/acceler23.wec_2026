                        "Triggers": [
                            {
                                "Condition": "{DriverInfo.Team.LogotypePath, Converter=EmptyObjectToTrue}",
                                "Property": "Source",
                                "Value": "{DriverInfo.Car.Vendor.LightLogotypePath}"
                            },
                            {
                                "Condition": "{ReplaceLogos}",
                                "ConditionAnd": "{Season.LineupsBasedType, Converter=EnumEquals, Parameter=Teams}",
                                "Property": "Source",
                                "Value": "{DriverInfo.Team.Car.Vendor.AlternativeLightLogotypePath}"
                            },
                            {
                                "Condition": "{ReplaceLogos}",
                                "ConditionAnd": "{Season.LineupsBasedType, Converter=EnumEquals, Parameter=Cars}",
                                "Property": "Source",
                                "Value": "{DriverInfo.Car.Vendor.AlternativeLightLogotypePath}"
                            }
                        ]
                    }
                ]
            },
            {
                "BlockType": "stack",
                "Orientation": "Vertical",
                "PositionY": 1400,
                "Width": 1500,
                "Spacing": -5,
                "Items": [
                    {
                        "BlockType": "text",
                        "Padding": "5",
                        "Source": "[{DriverInfo.Driver.{DriverName}, Converter=StringToUpperString}]",
                        "Foreground": "{newsRed}",
                        "FontName": "{DrukWide_Bold_Itallic}",
                        "FontSize": "{110, {Subtracts}{{DriverInfo.Driver.{DriverName}, Converter=GetStringLength}, {Multiplys}1}}",
                        "VerticalAlignment": "Center",
                        "TextOptions": { "FontStyle": "BoldItalic" },
                        "Triggers": [
                            {
                                "Condition": "{DriverName}",
                                "ConditionValue": "Short First Name",
                                "Property": "Source",
                                "Value": "[{DriverInfo.Driver.FirstName, Converter=MaxStringLength, Parameter=1}] [{DriverInfo.Driver.LastName, Converter=StringToUpperString}]"
                            }
                        ],
                        "HorizontalAlignment": "Center"
                    },
                    {
                        "BlockType": "text",
                        "Margin": "150, 0",
                        "Width": 1200,
                        "Source": "{NewsString, Converter=StringToUpperString}",
                        "Padding": "10",
                        "Foreground": "{white}",
                        "FontName": "{DrukWide_Bold_Itallic}",
                        "FontSize": "{110, {Subtracts}{{NewsString, Converter=GetStringLength}, {Multiplys}1}}",
                        "VerticalAlignment": "Center",
                        "TextOptions": {
                            "FontStyle": "BoldItalic",
                            "Wrap": true,
                            "TextAlignment": "Center"
                        }
                    }
                ]
